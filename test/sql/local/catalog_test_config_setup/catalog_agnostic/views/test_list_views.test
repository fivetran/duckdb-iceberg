# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/views/test_list_views.test
# description: test listing and scanning views in iceberg catalog
# group: [views]

require-env ICEBERG_SERVER_AVAILABLE

require avro

require parquet

require iceberg

require httpfs

require-env CATALOG_TEST_CONFIG_SETUP

# Do not ignore 'HTTP' error messages!
set ignore_error_messages

statement ok
CALL enable_logging('HTTP');

statement ok
set logging_level='debug'

statement ok
DROP VIEW IF EXISTS my_datalake.list_views_main.view_a;

statement ok
DROP VIEW IF EXISTS my_datalake.list_views_main.view_b;

statement ok
DROP VIEW IF EXISTS my_datalake.list_views_main.view_c;

statement ok
DROP TABLE IF EXISTS my_datalake.list_views_main.list_view_table;

statement ok
DROP SCHEMA IF EXISTS my_datalake.list_views_main;

statement ok
create schema my_datalake.list_views_main;

statement ok
use my_datalake.list_views_main;

# Create base table
statement ok
DROP TABLE IF EXISTS my_datalake.list_views_main.list_view_table;

statement ok
create table list_view_table (id int, name varchar);

statement ok
insert into list_view_table values (1, 'alice'), (2, 'bob'), (3, 'charlie');

# Initially no views should exist (or check count before creating)
statement ok
DROP VIEW IF EXISTS my_datalake.list_views_main.view_a;

statement ok
create view view_a as select * from list_view_table where id = 1;

statement ok
DROP VIEW IF EXISTS my_datalake.list_views_main.view_b;

statement ok
create view view_b as select * from list_view_table where id = 2;

statement ok
DROP VIEW IF EXISTS my_datalake.list_views_main.view_c;

statement ok
create view view_c as select * from list_view_table where id = 3;

# Test SHOW TABLES includes views (DuckDB behavior)
statement ok
show all tables;

# Test that we can see all views in information_schema
query I
select count(*) from information_schema.tables
where table_schema = 'list_views_main'
and table_name in ('view_a', 'view_b', 'view_c')
and table_type = 'VIEW';
----
3

# Test querying each view to ensure they're accessible
query II
select * from view_a;
----
1	alice

query II
select * from view_b;
----
2	bob

query II
select * from view_c;
----
3	charlie

# Create views in different schema
statement ok
DROP VIEW IF EXISTS my_datalake.list_schema.schema_view_1;

statement ok
DROP VIEW IF EXISTS my_datalake.list_schema.schema_view_2;

statement ok
DROP SCHEMA IF EXISTS my_datalake.list_schema;

statement ok
create schema my_datalake.list_schema;

statement ok
DROP VIEW IF EXISTS my_datalake.list_schema.schema_view_1;

statement ok
create view my_datalake.list_schema.schema_view_1 as select * from my_datalake.list_views_main.list_view_table;

statement ok
DROP VIEW IF EXISTS my_datalake.list_schema.schema_view_2;

statement ok
create view my_datalake.list_schema.schema_view_2 as select id from my_datalake.list_views_main.list_view_table;

# Test that views in different schemas are listed correctly
query I
select count(*) from information_schema.tables
where table_schema = 'list_schema'
and table_name in ('schema_view_1', 'schema_view_2')
and table_type = 'VIEW';
----
2

# Query views from different schema
query II
select * from my_datalake.list_schema.schema_view_1 order by id;
----
1	alice
2	bob
3	charlie

query I
select * from my_datalake.list_schema.schema_view_2 order by id;
----
1
2
3

# Test SHOW ALL TABLES shows both tables and views
statement ok
show all tables;

# Clean up views in default schema
statement ok
drop view view_a;

statement ok
drop view view_b;

statement ok
drop view view_c;

# Verify views are removed
query I
select count(*) from information_schema.tables
where table_schema = 'list_views_main'
and table_name in ('view_a', 'view_b', 'view_c');
----
0

# Clean up views in list_schema
statement ok
drop view my_datalake.list_schema.schema_view_1;

statement ok
drop view my_datalake.list_schema.schema_view_2;

statement ok
drop schema my_datalake.list_schema;

statement ok
drop table list_view_table;

