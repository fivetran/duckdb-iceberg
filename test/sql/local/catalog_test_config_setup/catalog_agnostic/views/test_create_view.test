# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/views/test_create_view.test
# description: test create view in iceberg catalog
# group: [views]

require-env ICEBERG_SERVER_AVAILABLE

require avro

require parquet

require iceberg

require httpfs

require-env CATALOG_TEST_CONFIG_SETUP

# Do not ignore 'HTTP' error messages!
set ignore_error_messages

statement ok
CALL enable_logging('HTTP');

statement ok
set logging_level='debug'

statement ok
create schema if not exists my_datalake.create_view_schema;

statement ok
use my_datalake.create_view_schema;

statement ok
drop table if exists view_base_table;

# Create a base table to use in views
statement ok
create table view_base_table (id int, name varchar, value double);

statement ok
insert into view_base_table values (1, 'alice', 100.5), (2, 'bob', 200.7), (3, 'charlie', 300.3);

statement ok
drop view if exists simple_view;

# Create a simple view
statement ok
create view simple_view as select * from view_base_table;

# Query the view
query III
select * from simple_view order by id;
----
1	alice	100.5
2	bob	200.7
3	charlie	300.3


statement ok
drop view if exists filtered_view;

# Create a view with a filter
statement ok
create view filtered_view as select id, name from view_base_table where value > 150;

query II
select * from filtered_view order by id;
----
2	bob
3	charlie


statement ok
drop view if exists agg_view;

# Create a view with aggregation
statement ok
create view agg_view as select count(*) as cnt, sum(value) as total from view_base_table;

query II
select * from agg_view;
----
3	601.5



statement ok
drop view if exists aliased_view;

# Create a view with column aliases
statement ok
create view aliased_view as select id as user_id, name as user_name from view_base_table;

query II
select * from aliased_view order by user_id;
----
1	alice
2	bob
3	charlie

# Test CREATE VIEW IF NOT EXISTS
#statement ok
#create view if not exists simple_view as select * from view_base_table;

# Error: CREATE VIEW without IF NOT EXISTS on existing view should fail
#statement error
#create view simple_view as select * from view_base_table;
#----
#<REGEX>:.*already exists.*

# Create view in a new schema
statement ok
DROP SCHEMA IF EXISTS my_datalake.view_schema;

statement ok
create schema my_datalake.view_schema;

statement ok
create view my_datalake.view_schema.schema_view as select * from my_datalake.create_view_schema.view_base_table where id = 1;

query III
select * from my_datalake.view_schema.schema_view;
----
1	alice	100.5

# Test view with joins
statement ok
create table view_base_table2 (id int, department varchar);

statement ok
insert into view_base_table2 values (1, 'engineering'), (2, 'sales'), (3, 'marketing');

statement ok
create view join_view as
select t1.id, t1.name, t2.department
from view_base_table t1
join view_base_table2 t2 on t1.id = t2.id;

query III
select * from join_view order by id;
----
1	alice	engineering
2	bob	sales
3	charlie	marketing

# Cleanup
statement ok
drop view join_view;

statement ok
drop view my_datalake.view_schema.schema_view;

statement ok
drop schema my_datalake.view_schema;

statement ok
drop view aliased_view;

statement ok
drop view agg_view;

statement ok
drop view filtered_view;

statement ok
drop view simple_view;

statement ok
drop table view_base_table2;

statement ok
drop table view_base_table;

